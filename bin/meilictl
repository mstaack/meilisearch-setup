#!/usr/bin/env bash
# meilictl - manage multiple Meilisearch instances behind Caddy on Debian/Ubuntu.
#
# Layout on the server:
#   /etc/meilisearch/meilictl.conf        global settings (REPO_URL, ACME_EMAIL)
#   /etc/meilisearch/instances/<name>.env one env file per instance (systemd EnvironmentFile)
#   /var/lib/meilisearch/<name>/          data, dumps, snapshots of an instance
#   /opt/meilisearch/versions/<ver>/      downloaded Meilisearch binaries
#   /usr/local/bin/meilisearch            symlink to the active version
#   /etc/caddy/meilisearch.d/<name>.caddy one Caddy site per instance
#   meilisearch@<name>.service            systemd template unit per instance
set -euo pipefail

MEILICTL_VERSION="0.1.0"

CONF_DIR="/etc/meilisearch"
CONF_FILE="$CONF_DIR/meilictl.conf"
INST_DIR="$CONF_DIR/instances"
DATA_DIR="/var/lib/meilisearch"
VERSIONS_DIR="/opt/meilisearch/versions"
BIN_LINK="/usr/local/bin/meilisearch"
CADDY_SITES="/etc/caddy/meilisearch.d"
CADDYFILE="/etc/caddy/Caddyfile"
CADDY_ACCESS_LOG="/var/log/caddy/access.log"
MEILI_USER="meilisearch"
BASE_PORT=7700
GITHUB_RELEASES="https://github.com/meilisearch/meilisearch/releases"

# Defaults, may be overridden by $CONF_FILE
REPO_URL="https://raw.githubusercontent.com/mstaack/meilisearch-setup/main"
ACME_EMAIL=""

# shellcheck disable=SC1090
[[ -f "$CONF_FILE" ]] && . "$CONF_FILE"

# ---------------------------------------------------------------- output ----
if [[ -t 1 ]]; then
  RED=$'\e[31m' GRN=$'\e[32m' YEL=$'\e[33m' BLU=$'\e[34m' BLD=$'\e[1m' DIM=$'\e[2m' RST=$'\e[0m'
else
  RED='' GRN='' YEL='' BLU='' BLD='' DIM='' RST=''
fi
info() { echo "${BLU}==>${RST} $*"; }
ok()   { echo "${GRN} ✔${RST} $*"; }
warn() { echo "${YEL} !${RST} $*" >&2; }
die()  { echo "${RED} ✘${RST} $*" >&2; exit 1; }

usage() {
  cat <<EOF
${BLD}meilictl${RST} $MEILICTL_VERSION - manage Meilisearch instances behind Caddy

${BLD}Instances${RST}
  create <name> --domain <domain> | --ip [addr]  [--port N] [--master-key KEY] [--allow IP,CIDR,...]
                              Create + start a new instance, served by Caddy on <domain>.
                              --ip: no domain, valid HTTPS on the server's public IP
                              (Let's Encrypt short-lived IP certificate, auto-renewed)
  list                        List all instances
  show <name>                 Show domain, port, master key, status
  start|stop|restart <name>... | --all
  enable|disable <name>       Start (or not) at boot
  status [name]               systemd status
  logs <name> [-f] [journalctl args]
  remove <name> [--purge] [-y]
                              Remove instance (--purge deletes its data)
  edit <name>                 Edit the instance env file (extra MEILI_* options)

${BLD}Settings${RST}
  set-domain <name> <domain>|--ip [addr]
                              Change the public domain (comma-separate for several) or switch to IP-only
  ip                          Print the server's public IPv4 (what --ip would use)
  set-key <name> [new-key]    Rotate the master key (random if omitted)
  keys <name>                 List API keys (default search/admin keys)
  allow <name>                Show the client IP allowlist
  allow <name> <ip|cidr>...   Only allow these clients, block everyone else (403)
  allow <name> --remove <ip>... | --clear

${BLD}Data${RST}
  snapshot <name>             Create a snapshot (/var/lib/meilisearch/<name>/snapshots)
  dump <name>                 Create a dump     (/var/lib/meilisearch/<name>/dumps)

${BLD}Software${RST}
  update [version] [--check] [--no-snapshot]
                              Update Meilisearch (all instances) to latest or given version
  versions                    List downloaded Meilisearch versions
  self-update                 Update meilictl itself from \$REPO_URL
  caddy init|render|validate|reload|logs
                              render: rewrite all Caddy site files (after meilictl self-update)
  config [email <addr> | repo-url <url>]
  security status|bans|ban <ip>|unban <ip>|test-filter
                              ufw + fail2ban overview and manual (un)bans
  version

Domains may be given as "search.example.com", "a.example.com,b.example.com",
a bare IPv4 address (HTTPS via Let's Encrypt IP certificate) or "http://host"
(plain HTTP, no certificate).
IPs for 'allow' may be single addresses, CIDRs (10.0.0.0/8, 2001:db8::/32) or
the keyword private_ranges.
EOF
}

# --------------------------------------------------------------- helpers ----
need_root() { [[ $EUID -eq 0 ]] || die "run as root: sudo meilictl $*"; }

validate_name() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] \
    || die "invalid instance name '$1' (use a-z, 0-9, '-' or '_', max 32 chars)"
}

validate_domain() {
  local d
  IFS=',' read -ra _domains <<<"$1"
  [[ ${#_domains[@]} -gt 0 ]] || die "empty domain"
  for d in "${_domains[@]}"; do
    [[ "$d" =~ ^(https?://)?[A-Za-z0-9*][A-Za-z0-9.*-]*(:[0-9]+)?$ ]] \
      || die "invalid domain '$d'"
  done
}

is_ipv4() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
is_private_ipv4() { [[ "$1" =~ ^(10\.|127\.|0\.|169\.254\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.) ]]; }
has_ip_host() { # any bare IPv4 among the comma-separated hosts?
  local d
  IFS=',' read -ra _hosts <<<"$1"
  for d in "${_hosts[@]}"; do is_ipv4 "$d" && return 0; done
  return 1
}
detect_public_ip() {
  local ip=""
  ip=$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null) \
    || ip=$(curl -4 -fsS --max-time 5 https://ifconfig.me/ip 2>/dev/null) \
    || ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')
  is_ipv4 "$ip" || die "could not detect the public IPv4 address, pass it explicitly: --ip <address>"
  echo "$ip"
}
# A domain argument of "ip" / "--ip" means "this server's public IPv4 address".
# "https://" prefixes and trailing slashes are dropped (HTTPS is Caddy's default);
# "http://" is kept because it means "plain HTTP, no certificate".
resolve_domain() {
  local out="" d scheme
  case "$1" in
    ip | --ip | auto) detect_public_ip; return ;;
  esac
  IFS=',' read -ra _hosts <<<"$1"
  for d in "${_hosts[@]}"; do
    scheme=""
    if [[ "$d" == http://* ]]; then scheme="http://"; d=${d#http://}; fi
    d=${d#https://}
    d=${d%%/*}
    [[ -n "$d" ]] && out+="${out:+,}$scheme$d"
  done
  echo "$out"
}
ip_cert_note() { # explain what happens for bare-IP hosts
  has_ip_host "$1" || return 0
  local d
  IFS=',' read -ra _hosts <<<"$1"
  for d in "${_hosts[@]}"; do
    is_ipv4 "$d" && is_private_ipv4 "$d" && warn "$d is not a public IP, Let's Encrypt cannot issue a certificate for it"
  done
  info "Caddy will request a short-lived (6-day) Let's Encrypt certificate for the IP and renew it automatically."
  info "Ports 80 and 443 must be reachable from the internet on that IP."
}

inst_file()   { echo "$INST_DIR/$1.env"; }
inst_exists() { [[ -f "$INST_DIR/$1.env" ]]; }
require_inst() {
  [[ -n "${1:-}" ]] || die "instance name required (see: meilictl list)"
  inst_exists "$1" || die "no such instance '$1' (see: meilictl list)"
}
inst_get() { sed -n "s/^$2=//p" "$INST_DIR/$1.env" | head -n1; }
inst_set() {
  local f="$INST_DIR/$1.env" tmp
  if grep -q "^$2=" "$f"; then
    tmp=$(mktemp)
    awk -v k="$2" -v v="$3" 'index($0, k"=")==1 {print k"="v; next} {print}' "$f" >"$tmp"
    cat "$tmp" >"$f"
    rm -f "$tmp"
  else
    echo "$2=$3" >>"$f"
  fi
}
all_instances() {
  local f
  for f in "$INST_DIR"/*.env; do
    [[ -e "$f" ]] || continue
    basename "$f" .env
  done
}
is_active() { systemctl is-active --quiet "meilisearch@$1"; }
svc_state() {
  if is_active "$1"; then echo "${GRN}running${RST}"
  elif systemctl is-failed --quiet "meilisearch@$1"; then echo "${RED}failed${RST}"
  else echo "${DIM}stopped${RST}"; fi
}

conf_set() {
  mkdir -p "$CONF_DIR"
  touch "$CONF_FILE"
  local tmp
  if grep -q "^$1=" "$CONF_FILE"; then
    tmp=$(mktemp)
    awk -v k="$1" -v v="$2" 'index($0, k"=")==1 {print k"=\"" v "\""; next} {print}' "$CONF_FILE" >"$tmp"
    cat "$tmp" >"$CONF_FILE"
    rm -f "$tmp"
  else
    echo "$1=\"$2\"" >>"$CONF_FILE"
  fi
}

domain_owner() { # prints instance owning any of the given domains (other than $2)
  local n d existing
  IFS=',' read -ra want <<<"$1"
  for n in $(all_instances); do
    [[ "$n" == "${2:-}" ]] && continue
    existing=$(inst_get "$n" MEILICTL_DOMAIN)
    IFS=',' read -ra have <<<"$existing"
    for d in "${want[@]}"; do
      local h
      for h in "${have[@]}"; do [[ "$d" == "$h" ]] && { echo "$n"; return 0; }; done
    done
  done
  return 1
}

port_in_use() {
  local p=$1 n
  for n in $(all_instances); do
    [[ "$(inst_get "$n" MEILICTL_PORT)" == "$p" ]] && return 0
  done
  ss -ltnH 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$p\$"
}
next_free_port() {
  local p=$BASE_PORT
  while port_in_use "$p"; do p=$((p + 1)); done
  echo "$p"
}

gen_key() {
  if command -v openssl >/dev/null 2>&1; then openssl rand -hex 32
  else tr -dc 'A-Za-z0-9' </dev/urandom | head -c 64; fi
}
validate_key() {
  [[ ${#1} -ge 16 ]] || die "master key must be at least 16 characters"
  [[ "$1" =~ ^[^[:space:]\"\'\\#]+$ ]] || die "master key must not contain whitespace, quotes, '#' or backslashes"
}

# ----------------------------------------------------------------- caddy ----
caddy_hosts() { echo "${1//,/, }"; }

write_caddy_site() { # name domains port [allowlist]
  mkdir -p "$CADDY_SITES"
  local allow=${4:-}
  {
    echo "# Managed by meilictl for instance \"$1\"."
    echo "# Change with: meilictl set-domain $1 <domain>   /   meilictl allow $1 <ip>..."
    echo "$(caddy_hosts "$2") {"
    if has_ip_host "$2"; then
      echo "    # Bare IP address: Let's Encrypt only issues IP certificates with the"
      echo "    # short-lived profile (~6 days). Caddy renews them automatically."
      echo "    tls {"
      echo "        issuer acme https://acme-v02.api.letsencrypt.org/directory {"
      echo "            profile shortlived"
      echo "        }"
      echo "    }"
    fi
    if [[ -n "$allow" ]]; then
      echo "    # only these clients may connect, everyone else gets 403"
      echo "    @blocked not remote_ip ${allow//,/ }"
      echo "    respond @blocked 403"
    fi
    echo "    reverse_proxy 127.0.0.1:$3"
    echo "    # JSON access log, shared by all instances; read by the fail2ban jail 'caddy-meili'"
    echo "    log {"
    echo "        output file $CADDY_ACCESS_LOG {"
    echo "            roll_size 20mb"
    echo "            roll_keep 5"
    echo "        }"
    echo "        format json {"
    echo "            time_format iso8601"
    echo "        }"
    echo "    }"
    echo "}"
  } >"$CADDY_SITES/$1.caddy"
}

validate_cidr() {
  local ip=$1
  [[ "$ip" == private_ranges ]] && return 0
  # IPv4 with optional prefix
  if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$ ]]; then
    local o; IFS='./' read -ra o <<<"$ip"
    for i in 0 1 2 3; do ((o[i] <= 255)) || die "invalid IPv4 address '$ip'"; done
    [[ -z "${o[4]:-}" ]] || ((o[4] <= 32)) || die "invalid prefix length in '$ip'"
    return 0
  fi
  # IPv6 (loose check) with optional prefix
  [[ "$ip" =~ ^[0-9A-Fa-f:]+(/[0-9]{1,3})?$ && "$ip" == *:* ]] && return 0
  die "invalid IP or CIDR '$ip' (examples: 203.0.113.7, 10.0.0.0/8, 2001:db8::/32, private_ranges)"
}

# Re-render the Caddy site of an instance from its env file, rolling back on error.
rerender_site() { # name
  local n=$1 bak
  bak=$(mktemp)
  cp "$CADDY_SITES/$n.caddy" "$bak" 2>/dev/null || true
  write_caddy_site "$n" "$(inst_get "$n" MEILICTL_DOMAIN)" "$(inst_get "$n" MEILICTL_PORT)" "$(inst_get "$n" MEILICTL_ALLOW)"
  if ! caddy_reload; then
    if [[ -s "$bak" ]]; then cp "$bak" "$CADDY_SITES/$n.caddy"; else rm -f "$CADDY_SITES/$n.caddy"; fi
    rm -f "$bak"
    return 1
  fi
  rm -f "$bak"
}

caddy_validate() {
  local out
  if ! out=$(caddy validate --config "$CADDYFILE" --adapter caddyfile 2>&1); then
    echo "$out" >&2
    return 1
  fi
}
caddy_reload() {
  caddy_validate || return 1
  systemctl reload caddy 2>/dev/null || systemctl restart caddy
}

write_managed_caddyfile() {
  {
    echo "# Managed by meilictl. Per-instance sites live in $CADDY_SITES/"
    echo "# Set the ACME e-mail with: meilictl config email you@example.com"
    if [[ -n "$ACME_EMAIL" ]]; then
      printf '{\n    email %s\n}\n\n' "$ACME_EMAIL"
    fi
    echo "import $CADDY_SITES/*.caddy"
  } >"$CADDYFILE"
}

caddy_init() {
  mkdir -p "$CADDY_SITES" "$(dirname "$CADDYFILE")"
  install -d -m 750 -o caddy -g caddy "$(dirname "$CADDY_ACCESS_LOG")" 2>/dev/null || true
  [[ -e "$CADDY_ACCESS_LOG" ]] || { touch "$CADDY_ACCESS_LOG"; chown caddy:caddy "$CADDY_ACCESS_LOG" 2>/dev/null || true; }
  if [[ ! -f "$CADDYFILE" ]] || grep -q 'root \* /usr/share/caddy' "$CADDYFILE" || grep -q '^# Managed by meilictl' "$CADDYFILE"; then
    write_managed_caddyfile
    ok "wrote $CADDYFILE"
  elif ! grep -qF "import $CADDY_SITES/*.caddy" "$CADDYFILE"; then
    printf '\n# added by meilictl\nimport %s/*.caddy\n' "$CADDY_SITES" >>"$CADDYFILE"
    ok "appended import line to existing $CADDYFILE"
  else
    ok "$CADDYFILE already imports $CADDY_SITES"
  fi
  systemctl enable --now caddy >/dev/null 2>&1 || true
  caddy_reload
}

# ------------------------------------------------------------------- api ----
api() { # name method path [json-body]
  local port key
  port=$(inst_get "$1" MEILICTL_PORT)
  key=$(inst_get "$1" MEILI_MASTER_KEY)
  if [[ -n "${4:-}" ]]; then
    curl -sS -X "$2" -H "Authorization: Bearer $key" -H 'Content-Type: application/json' \
      -d "$4" "http://127.0.0.1:$port$3"
  else
    curl -sS -X "$2" -H "Authorization: Bearer $key" "http://127.0.0.1:$port$3"
  fi
}
json_get() { # key  (naive, good enough for flat Meilisearch responses)
  grep -o "\"$1\":[^,}]*" | head -n1 | sed 's/^"[^"]*"://; s/^"//; s/"$//'
}
pretty_json() {
  if command -v jq >/dev/null 2>&1; then jq .; else cat; echo; fi
}
wait_task() { # name taskUid [timeout-seconds]
  local i=0 st timeout=${3:-900}
  while ((i < timeout)); do
    st=$(api "$1" GET "/tasks/$2" | json_get status)
    case "$st" in
      succeeded) return 0 ;;
      failed | canceled) return 1 ;;
    esac
    sleep 1
    i=$((i + 1))
  done
  return 2
}
wait_healthy() {
  local port i
  port=$(inst_get "$1" MEILICTL_PORT)
  for i in $(seq 1 60); do
    curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1 && return 0
    systemctl is-active --quiet "meilisearch@$1" || return 1
    sleep 0.5
  done
  return 1
}
run_task() { # name label path
  require_inst "$1"
  is_active "$1" || die "instance '$1' is not running"
  local uid
  uid=$(api "$1" POST "$3" | json_get taskUid)
  [[ -n "$uid" ]] || die "could not start $2 (no taskUid in response)"
  info "$2 task #$uid started, waiting..."
  if wait_task "$1" "$uid"; then ok "$2 finished"; else die "$2 failed or timed out (task #$uid)"; fi
}

# -------------------------------------------------------------- versions ----
arch_asset() {
  case "$(uname -m)" in
    x86_64 | amd64) echo meilisearch-linux-amd64 ;;
    aarch64 | arm64) echo meilisearch-linux-aarch64 ;;
    *) die "unsupported architecture: $(uname -m)" ;;
  esac
}
latest_version() {
  local loc
  loc=$(curl -fsSI -o /dev/null -w '%{redirect_url}' "$GITHUB_RELEASES/latest") || die "cannot reach GitHub"
  [[ -n "$loc" ]] || die "could not determine latest Meilisearch version"
  echo "${loc##*/}"
}
normalize_version() { [[ "$1" == v* ]] && echo "$1" || echo "v$1"; }
current_version() {
  if [[ -L "$BIN_LINK" ]]; then basename "$(dirname "$(readlink -f "$BIN_LINK")")"; else echo none; fi
}
install_version() {
  local v=$1 dir="$VERSIONS_DIR/$1" url
  [[ -x "$dir/meilisearch" ]] && return 0
  url="$GITHUB_RELEASES/download/$v/$(arch_asset)"
  mkdir -p "$dir"
  info "downloading Meilisearch $v"
  if ! curl -fL --progress-bar -o "$dir/meilisearch.tmp" "$url"; then
    rm -rf "$dir"
    die "download failed: $url"
  fi
  chmod 755 "$dir/meilisearch.tmp"
  mv "$dir/meilisearch.tmp" "$dir/meilisearch"
  "$dir/meilisearch" --version >/dev/null 2>&1 || { rm -rf "$dir"; die "downloaded binary does not run"; }
}
activate_version() { mkdir -p "$(dirname "$BIN_LINK")"; ln -sfn "$VERSIONS_DIR/$1/meilisearch" "$BIN_LINK"; }

# -------------------------------------------------------------- commands ----
cmd_create() {
  need_root create
  local name="" domain="" port="" key="" allow=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --domain | -d) domain=${2:-}; shift 2 ;;
      --port | -p) port=${2:-}; shift 2 ;;
      --master-key | -k) key=${2:-}; shift 2 ;;
      --allow | -a) allow=${2:-}; shift 2 ;;
      --ip) if [[ -n "${2:-}" && "$2" != -* ]]; then domain=$2; shift 2; else domain=ip; shift; fi ;;
      -*) die "unknown option: $1" ;;
      *) if [[ -z "$name" ]]; then name=$1; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: meilictl create <name> --domain <domain> | --ip [addr]  [--port N] [--master-key KEY] [--allow IP,CIDR,...]"
  validate_name "$name"
  inst_exists "$name" && die "instance '$name' already exists"
  [[ -n "$domain" ]] || die "--domain <domain> or --ip is required"
  domain=$(resolve_domain "$domain")
  validate_domain "$domain"
  ip_cert_note "$domain"
  allow=$(normalize_allow "$allow")
  local owner
  if owner=$(domain_owner "$domain"); then die "domain already used by instance '$owner'"; fi
  [[ -x "$BIN_LINK" ]] || die "Meilisearch binary missing, run: meilictl update"

  if [[ -z "$port" ]]; then port=$(next_free_port)
  else
    [[ "$port" =~ ^[0-9]+$ ]] || die "invalid port"
    port_in_use "$port" && die "port $port is already in use"
  fi
  if [[ -z "$key" ]]; then key=$(gen_key); else validate_key "$key"; fi

  info "creating instance '$name' on 127.0.0.1:$port for $domain"
  mkdir -p "$INST_DIR" "$DATA_DIR/$name"/{dumps,snapshots}
  chown -R "$MEILI_USER:$MEILI_USER" "$DATA_DIR/$name"
  chmod 750 "$DATA_DIR/$name"

  cat >"$INST_DIR/$name.env" <<EOF
# Managed by meilictl. Change key/domain with 'meilictl set-key' / 'meilictl set-domain'.
# Extra Meilisearch options (MEILI_*) may be added here; restart the instance afterwards.
MEILI_ENV=production
MEILI_HTTP_ADDR=127.0.0.1:$port
MEILI_MASTER_KEY=$key
MEILI_DB_PATH=$DATA_DIR/$name/data.ms
MEILI_DUMP_DIR=$DATA_DIR/$name/dumps
MEILI_SNAPSHOT_DIR=$DATA_DIR/$name/snapshots
MEILI_NO_ANALYTICS=true
MEILI_EXPERIMENTAL_DUMPLESS_UPGRADE=true
MEILICTL_DOMAIN=$domain
MEILICTL_PORT=$port
MEILICTL_ALLOW=$allow
EOF
  chmod 640 "$INST_DIR/$name.env"
  chown "root:$MEILI_USER" "$INST_DIR/$name.env"

  write_caddy_site "$name" "$domain" "$port" "$allow"
  systemctl enable --now "meilisearch@$name" >/dev/null 2>&1
  if wait_healthy "$name"; then ok "meilisearch@$name is running"
  else
    journalctl -u "meilisearch@$name" -n 20 --no-pager >&2 || true
    die "instance did not become healthy, see: meilictl logs $name"
  fi
  if caddy_reload; then ok "caddy reloaded"; else warn "caddy reload failed, fix $CADDYFILE and run: meilictl caddy reload"; fi
  echo
  cmd_show "$name"
}

cmd_list() {
  local n found=0 w=9
  [[ -n "$RST" ]] && w=18 # room for the colour codes around the state
  printf "${BLD}%-18s %-9s %-6s %s${RST}\n" NAME STATUS PORT DOMAIN
  for n in $(all_instances); do
    found=1
    printf "%-18s %-${w}s %-6s %s\n" "$n" "$(svc_state "$n")" "$(inst_get "$n" MEILICTL_PORT)" "$(inst_get "$n" MEILICTL_DOMAIN)"
  done
  ((found)) || echo "${DIM}(no instances; create one with: meilictl create <name> --domain <domain>)${RST}"
}

cmd_show() {
  require_inst "${1:-}"
  local n=$1 domain port first url ver
  domain=$(inst_get "$n" MEILICTL_DOMAIN)
  port=$(inst_get "$n" MEILICTL_PORT)
  first=${domain%%,*}
  if [[ "$first" == http://* || "$first" == https://* ]]; then url=$first; else url="https://$first"; fi
  ver=$(current_version)
  if is_active "$n"; then ver=$(api "$n" GET /version 2>/dev/null | json_get pkgVersion || true); ver="v${ver:-?}"; fi
  echo "${BLD}Instance:${RST}     $n"
  echo "${BLD}Status:${RST}       $(svc_state "$n")"
  echo "${BLD}Domain:${RST}       $(caddy_hosts "$domain")"
  echo "${BLD}URL:${RST}          $url"
  has_ip_host "$domain" && echo "${BLD}TLS:${RST}          Let's Encrypt short-lived IP certificate (6 days, auto-renewed by Caddy)"
  echo "${BLD}Local:${RST}        http://127.0.0.1:$port"
  local allow; allow=$(inst_get "$n" MEILICTL_ALLOW)
  if [[ -n "$allow" ]]; then echo "${BLD}Allowed IPs:${RST}  ${allow//,/, }  ${DIM}(all others get 403)${RST}"
  else echo "${BLD}Allowed IPs:${RST}  everyone  ${DIM}(restrict with: meilictl allow $n <ip>...)${RST}"; fi
  echo "${BLD}Master key:${RST}   $(inst_get "$n" MEILI_MASTER_KEY)"
  echo "${BLD}Meilisearch:${RST}  $ver"
  echo "${BLD}Data:${RST}         $DATA_DIR/$n"
  echo "${BLD}Env file:${RST}     $INST_DIR/$n.env"
  echo "${BLD}Service:${RST}      meilisearch@$n.service"
}

cmd_svc() { # action names...|--all
  need_root "$1"
  local action=$1; shift
  local names=()
  if [[ "${1:-}" == "--all" || "${1:-}" == "-a" ]]; then
    for n in $(all_instances); do names+=("$n"); done
  else
    names=("$@")
  fi
  [[ ${#names[@]} -gt 0 ]] || die "usage: meilictl $action <name>... | --all"
  local n
  for n in "${names[@]}"; do
    require_inst "$n"
    case "$action" in
      start | restart)
        systemctl "$action" "meilisearch@$n"
        if wait_healthy "$n"; then ok "$n: $(svc_state "$n")"; else warn "$n did not become healthy, see: meilictl logs $n"; fi ;;
      stop) systemctl stop "meilisearch@$n"; ok "$n: $(svc_state "$n")" ;;
      enable) systemctl enable "meilisearch@$n" >/dev/null 2>&1; ok "$n enabled at boot" ;;
      disable) systemctl disable "meilisearch@$n" >/dev/null 2>&1; ok "$n disabled at boot" ;;
    esac
  done
}

cmd_status() {
  if [[ -n "${1:-}" ]]; then
    require_inst "$1"
    systemctl status "meilisearch@$1" --no-pager || true
  else
    cmd_list
    echo
    systemctl status caddy --no-pager 2>/dev/null | head -n 5 || true
  fi
}

cmd_logs() {
  require_inst "${1:-}"
  local n=$1; shift
  if [[ $# -eq 0 ]]; then journalctl -u "meilisearch@$n" -n 100 --no-pager
  else journalctl -u "meilisearch@$n" "$@"; fi
}

cmd_remove() {
  need_root remove
  local name="" purge=0 yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --purge) purge=1 ;;
      -y | --yes) yes=1 ;;
      -*) die "unknown option: $1" ;;
      *) name=$1 ;;
    esac
    shift
  done
  require_inst "$name"
  validate_name "$name"
  if ((!yes)); then
    local msg="Remove instance '$name'"
    ((purge)) && msg+=" AND DELETE ALL ITS DATA in $DATA_DIR/$name"
    read -r -p "$msg? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || die "aborted"
  fi
  systemctl disable --now "meilisearch@$name" >/dev/null 2>&1 || true
  rm -f "$INST_DIR/$name.env" "$CADDY_SITES/$name.caddy"
  caddy_reload || warn "caddy reload failed"
  if ((purge)); then
    rm -rf "${DATA_DIR:?}/${name:?}"
    ok "instance '$name' removed, data deleted"
  else
    ok "instance '$name' removed, data kept in $DATA_DIR/$name (delete manually if unwanted)"
  fi
}

cmd_edit() {
  need_root edit
  require_inst "${1:-}"
  "${EDITOR:-nano}" "$INST_DIR/$1.env"
  if is_active "$1"; then
    read -r -p "Restart meilisearch@$1 now? [Y/n] " ans
    [[ "$ans" =~ ^[Nn]$ ]] || cmd_svc restart "$1"
  fi
}

cmd_set_domain() {
  need_root set-domain
  require_inst "${1:-}"
  local n=$1 domain=${2:-} owner old
  [[ -n "$domain" ]] || die "usage: meilictl set-domain <name> <domain> | --ip [addr]"
  if [[ "$domain" == --ip && -n "${3:-}" ]]; then domain=$3; fi
  domain=$(resolve_domain "$domain")
  validate_domain "$domain"
  ip_cert_note "$domain"
  if owner=$(domain_owner "$domain" "$n"); then die "domain already used by instance '$owner'"; fi
  old=$(inst_get "$n" MEILICTL_DOMAIN)
  inst_set "$n" MEILICTL_DOMAIN "$domain"
  if ! rerender_site "$n"; then
    inst_set "$n" MEILICTL_DOMAIN "$old"
    die "Caddy rejected the new config, previous domain restored"
  fi
  ok "$n now served on $(caddy_hosts "$domain")"
}

# Normalize a comma/space separated list of IPs/CIDRs: validate, dedupe, join with ','.
normalize_allow() {
  local out="" ip
  # shellcheck disable=SC2206
  local items=(${1//,/ })
  for ip in ${items[@]+"${items[@]}"}; do
    validate_cidr "$ip"
    [[ ",$out," == *",$ip,"* ]] || out+="${out:+,}$ip"
  done
  echo "$out"
}

cmd_allow() {
  require_inst "${1:-}"
  local n=$1; shift
  local cur new mode=add ip
  cur=$(inst_get "$n" MEILICTL_ALLOW)
  if [[ $# -eq 0 ]]; then
    if [[ -n "$cur" ]]; then echo "${cur//,/$'\n'}"; else echo "(no allowlist: everyone may connect)"; fi
    return 0
  fi
  need_root allow
  case "$1" in
    --remove | -r | remove | rm) mode=remove; shift ;;
    --clear | clear | reset) mode=clear; shift ;;
    add) shift ;;
  esac
  case "$mode" in
    clear) new="" ;;
    add) new=$(normalize_allow "$cur,$*") ;;
    remove)
      [[ $# -gt 0 ]] || die "usage: meilictl allow <name> --remove <ip>..."
      new=$cur
      for ip in $(normalize_allow "$*"); do
        new=",$new,"; new=${new//,$ip,/,}; new=${new#,}; new=${new%,}
      done ;;
  esac
  [[ "$new" != "$cur" ]] || { ok "allowlist unchanged"; return 0; }
  inst_set "$n" MEILICTL_ALLOW "$new"
  if ! rerender_site "$n"; then
    inst_set "$n" MEILICTL_ALLOW "$cur"
    die "Caddy rejected the new config, previous allowlist restored"
  fi
  if [[ -n "$new" ]]; then ok "$n: only ${new//,/, } may connect, all other clients get 403"
  else ok "$n: allowlist cleared, everyone may connect"; fi
}

cmd_set_key() {
  need_root set-key
  require_inst "${1:-}"
  local n=$1 key=${2:-}
  if [[ -z "$key" ]]; then key=$(gen_key); else validate_key "$key"; fi
  inst_set "$n" MEILI_MASTER_KEY "$key"
  if is_active "$n"; then
    systemctl restart "meilisearch@$n"
    wait_healthy "$n" || warn "$n did not become healthy, see: meilictl logs $n"
  fi
  ok "master key of '$n' changed"
  echo "$key"
  warn "API key values are derived from the master key, so the default search/admin keys changed too."
  warn "Fetch the new ones with: meilictl keys $n"
}

cmd_keys() {
  require_inst "${1:-}"
  is_active "$1" || die "instance '$1' is not running"
  api "$1" GET "/keys?limit=100" | pretty_json
}

cmd_update() {
  need_root update
  local target=latest check=0 snapshot=1 cur n
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) check=1 ;;
      --no-snapshot) snapshot=0 ;;
      -*) die "unknown option: $1" ;;
      *) target=$1 ;;
    esac
    shift
  done
  if [[ "$target" == latest ]]; then target=$(latest_version); else target=$(normalize_version "$target"); fi
  cur=$(current_version)
  echo "installed: $cur    target: $target"
  ((check)) && return 0
  if [[ "$cur" == "$target" ]]; then ok "already on $target"; return 0; fi
  install_version "$target"

  local running=()
  for n in $(all_instances); do
    is_active "$n" && running+=("$n")
    inst_set "$n" MEILI_EXPERIMENTAL_DUMPLESS_UPGRADE true
  done
  if ((snapshot)); then
    for n in ${running[@]+"${running[@]}"}; do
      run_task "$n" "snapshot of $n" /snapshots || warn "snapshot of $n failed, continuing"
    done
  fi
  for n in ${running[@]+"${running[@]}"}; do systemctl stop "meilisearch@$n"; done
  activate_version "$target"
  ok "active Meilisearch binary: $target"
  for n in ${running[@]+"${running[@]}"}; do systemctl start "meilisearch@$n"; done
  for n in ${running[@]+"${running[@]}"}; do
    if wait_healthy "$n"; then ok "$n running on $target"; else warn "$n not healthy, see: meilictl logs $n"; fi
  done
  [[ "$cur" == none ]] || echo "Rollback with: meilictl update $cur   (only safe if the database format is compatible)"
}

cmd_versions() {
  local cur d v
  cur=$(current_version)
  for d in "$VERSIONS_DIR"/*/; do
    [[ -d "$d" ]] || continue
    v=$(basename "$d")
    if [[ "$v" == "$cur" ]]; then echo "* $v (active)"; else echo "  $v"; fi
  done
  [[ "$cur" == none ]] && echo "(no Meilisearch installed, run: meilictl update)"
  echo "Remove unused versions with: rm -rf $VERSIONS_DIR/<version>"
}

cmd_self_update() {
  need_root self-update
  local tmp
  tmp=$(mktemp)
  curl -fsSL "$REPO_URL/bin/meilictl" -o "$tmp" || die "download failed: $REPO_URL/bin/meilictl"
  bash -n "$tmp" || die "downloaded meilictl has a syntax error, not installing"
  install -m 755 "$tmp" /usr/local/bin/meilictl
  rm -f "$tmp"
  ok "meilictl updated: $(/usr/local/bin/meilictl version)"
  echo "Apply Caddy template changes to existing instances with: meilictl caddy render"
}

render_all_sites() { # rewrite every instance's Caddy site from its env file (after template changes)
  local n count=0 domain fixed
  for n in $(all_instances); do
    domain=$(inst_get "$n" MEILICTL_DOMAIN)
    fixed=$(resolve_domain "$domain")
    if [[ "$fixed" != "$domain" ]]; then
      inst_set "$n" MEILICTL_DOMAIN "$fixed"
      info "$n: normalized domain '$domain' -> '$fixed'"
      domain=$fixed
    fi
    write_caddy_site "$n" "$domain" "$(inst_get "$n" MEILICTL_PORT)" "$(inst_get "$n" MEILICTL_ALLOW)"
    count=$((count + 1))
  done
  # A full restart (not reload) is needed when a site switches issuer (e.g. internal -> Let's Encrypt):
  # Caddy keeps the old certificate in its in-memory cache across reloads and then never obtains the new one.
  caddy_validate || return 1
  systemctl restart caddy && ok "re-rendered $count Caddy site(s), caddy restarted"
}

cmd_caddy() {
  case "${1:-}" in
    init) need_root caddy; caddy_init ;;
    render) need_root caddy; render_all_sites ;;
    validate) caddy_validate && ok "Caddyfile valid" ;;
    reload) need_root caddy; caddy_reload && ok "caddy reloaded" ;;
    logs) shift; journalctl -u caddy "${@:--n 100 --no-pager}" ;;
    *) die "usage: meilictl caddy init|render|validate|reload|logs" ;;
  esac
}

cmd_security() {
  local sub=${1:-status}
  case "$sub" in
    status)
      echo "${BLD}Firewall (ufw)${RST}"
      if command -v ufw >/dev/null 2>&1; then ufw status verbose 2>/dev/null || warn "cannot read ufw status (run as root?)"
      else echo "  ufw not installed"; fi
      echo
      echo "${BLD}fail2ban${RST}"
      if command -v fail2ban-client >/dev/null 2>&1; then
        local jails j
        jails=$(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr -d ',') || true
        [[ -n "$jails" ]] || { warn "fail2ban not running or no jails"; return 0; }
        for j in $jails; do
          echo "  [$j]"
          fail2ban-client status "$j" 2>/dev/null | grep -E 'Currently (failed|banned)|Total banned|Banned IP list' \
            | sed -E 's/^[| `-]+//; s/^/    /'
        done
      else echo "  fail2ban not installed"; fi ;;
    bans)
      need_root security
      local jails j
      jails=$(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr -d ',') || true
      for j in $jails; do printf '%-14s %s\n' "$j:" "$(fail2ban-client get "$j" banip 2>/dev/null | tr '\n' ' ')"; done ;;
    unban)
      need_root security
      [[ -n "${2:-}" ]] || die "usage: meilictl security unban <ip>"
      fail2ban-client unban "$2" >/dev/null && ok "$2 unbanned in all jails" ;;
    ban)
      need_root security
      [[ -n "${2:-}" ]] || die "usage: meilictl security ban <ip>"
      fail2ban-client set caddy-meili banip "$2" >/dev/null && ok "$2 banned (jail caddy-meili)" ;;
    test-filter)
      fail2ban-regex "$CADDY_ACCESS_LOG" /etc/fail2ban/filter.d/caddy-meili.conf 2>/dev/null | grep -E '^(Lines|Failregex|Date template hits)|^\s*\[[0-9]+\]' || die "fail2ban-regex failed" ;;
    *) die "usage: meilictl security status|bans|ban <ip>|unban <ip>|test-filter" ;;
  esac
}

cmd_config() {
  case "${1:-}" in
    "")
      echo "config file: $CONF_FILE"
      echo "REPO_URL=$REPO_URL"
      echo "ACME_EMAIL=${ACME_EMAIL:-<not set>}" ;;
    email)
      need_root config
      [[ -n "${2:-}" ]] || die "usage: meilictl config email <address>"
      conf_set ACME_EMAIL "$2"; ACME_EMAIL=$2
      if grep -q '^# Managed by meilictl' "$CADDYFILE" 2>/dev/null; then
        write_managed_caddyfile
        caddy_reload && ok "ACME e-mail set to $2, caddy reloaded"
      else
        ok "ACME e-mail saved; $CADDYFILE is not managed by meilictl, add 'email $2' to its global options yourself"
      fi ;;
    repo-url)
      need_root config
      [[ -n "${2:-}" ]] || die "usage: meilictl config repo-url <url>"
      conf_set REPO_URL "${2%/}"; ok "REPO_URL set" ;;
    *) die "usage: meilictl config [email <addr> | repo-url <url>]" ;;
  esac
}

main() {
  local cmd=${1:-help}
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    create | add) cmd_create "$@" ;;
    list | ls) cmd_list ;;
    show | info) cmd_show "$@" ;;
    start | stop | restart | enable | disable) cmd_svc "$cmd" "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    remove | rm | delete) cmd_remove "$@" ;;
    edit) cmd_edit "$@" ;;
    set-domain | domain) cmd_set_domain "$@" ;;
    ip | public-ip) detect_public_ip ;;
    set-key | rotate-key) cmd_set_key "$@" ;;
    allow | allowlist | whitelist) cmd_allow "$@" ;;
    keys) cmd_keys "$@" ;;
    snapshot) run_task "${1:-}" "snapshot" /snapshots ;;
    dump) run_task "${1:-}" "dump" /dumps ;;
    update | upgrade) cmd_update "$@" ;;
    versions) cmd_versions ;;
    self-update) cmd_self_update ;;
    caddy) cmd_caddy "$@" ;;
    config) cmd_config "$@" ;;
    security | sec) cmd_security "$@" ;;
    version | --version | -v) echo "meilictl $MEILICTL_VERSION (meilisearch $(current_version))" ;;
    help | -h | --help) usage ;;
    *) die "unknown command '$cmd' (try: meilictl help)" ;;
  esac
}

main "$@"
